# TDR DataSharing APIs (phase collection)
TDR_BASE_URL=https://gisdemo.mp.gov.in/TDR/TDRService/api/DataSharing
TDR_API_KEY=
TDR_AUTH_HEADER=Authorization

# MP-TDR Fabric API (legacy write + read-back)
BLOCKCHAIN_BASE_URL=https://mpbsp-uat.mp.gov.in
BLOCKCHAIN_API_KEY=change-me
CHANNEL=mptdr
ORG=mpgovdepartment
PEER=peer0-mpgovdepartment

# Optional. TDR has not published this yet; leave empty to skip.
TDR_CALLBACK_URL=

STATE_PATH=./data/state.json
HTTP_HOST=0.0.0.0
HTTP_PORT=8088
SCHEDULER_API_KEY=

# Dashboard sign-in. Change the password on the server.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

# Phase 1 is DRC-only scheduled verification (no blockchain writes).
PHASE1_ENABLED=true
PHASE1_INTERVAL_SEC=86400
PHASE1_CONCURRENCY=4

# Phase 2 daily time and hours are chosen on the Run screen.
# PHASE2_ENABLED does not start that run. Leave it false.
PHASE2_ENABLED=false
PHASE2_INTERVAL_SEC=86400
PHASE2_SCAN_CERTS=true

# Phase 3 is started from the Run screen when you need one live application.
PHASE3_ENABLED=false
PHASE3_INTERVAL_SEC=300
PHASE3_SCAN_CERTS=false

DRY_RUN=false
HTTP_TIMEOUT_SEC=60
MAX_RETRIES=5
CHANGED_BY=tdr-scheduler

# INFO logs phases, applications, and stage results. DEBUG also logs each HTTP call.
LOG_LEVEL=INFO
